datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             Int                @id @default(autoincrement())
  email          String             @unique
  hashedPassword String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  profile        CandidateProfile?
  resumes        Resume[]
  policy         ApplicationPolicy?
  automation     AutomationConfig?
}

model CandidateProfile {
  resumeVersions     ResumeVersion[]
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  user               User     @relation(fields: [userId], references: [id])
  name               String?
  phone              String?
  location           String?
  linkedin           String?
  github             String?
  portfolio          String?
  education          Json?
  experience         Json?
  skills             Json?
  projects           Json?
  certifications     Json?
  preferredRoles     String[]
  preferredLocations String[]
  remotePreference   String?
  minimumSalary      Int?
  maximumSalary      Int?
  employmentTypes    String[]
  workAuthorization  String?
  noticePeriod       String?
  applications       Application[]
}

model Resume {
  derivedVersions ResumeVersion[]
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  fileName  String
  fileUrl   String
  isMaster  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ApplicationPolicy {
  id                    Int      @id @default(autoincrement())
  userId                Int      @unique
  user                  User     @relation(fields: [userId], references: [id])
  targetRoles           String[]
  targetTechnologies    String[]
  preferredCompanies    String[]
  excludedCompanies     String[]
  excludedKeywords      String[]
  minimumMatchScore     Int?
  maxApplicationsPerDay Int?
  autoApplyEnabled      Boolean  @default(false)
}

model JobSource {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  config    Json?
  jobs      Job[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  website     String?
  description String?
  jobs        Job[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Job {
  resumeVersions       ResumeVersion[]
  id                   Int          @id @default(autoincrement())
  externalId           String
  sourceId             Int
  source               JobSource    @relation(fields: [sourceId], references: [id])
  title                String
  companyId            Int?
  company              Company?     @relation(fields: [companyId], references: [id])
  location             String?
  remoteType           String?
  description          String
  url                  String
  employmentType       String?
  salaryMin            Int?
  salaryMax            Int?
  currency             String?
  postedAt             DateTime
  skills               String[]
  canonicalFingerprint String       @unique
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  analysis             JobAnalysis?
  applications         Application[]

  @@unique([sourceId, externalId])
  @@index([sourceId])
  @@index([companyId])
}

model JobAnalysis {
  id              Int      @id @default(autoincrement())
  jobId           Int      @unique
  job             Job      @relation(fields: [jobId], references: [id])
  matchScore      Int
  recommendation  String
  skillsMatched   String[]
  skillsMissing   String[]
  experienceMatch String?
  educationMatch  String?
  locationMatch   String?
  reasoning       String
  createdAt       DateTime @default(now())

  @@index([matchScore])
}

enum ApplicationStatus {
  DISCOVERED
  ANALYZING
  REJECTED
  MATCHED
  QUEUED
  RESUME_GENERATING
  READY_TO_APPLY
  APPLYING
  SUBMITTED
  VERIFYING
  VERIFIED
  FAILED
  RETRYING
  NEEDS_HUMAN
  CANCELLED
}

model Application {
  resumeVersions ResumeVersion[]
  id             Int               @id @default(autoincrement())
  candidateId    Int
  candidate      CandidateProfile  @relation(fields: [candidateId], references: [id])
  jobId          Int
  job            Job               @relation(fields: [jobId], references: [id])
  canonicalJobId String
  status         ApplicationStatus @default(DISCOVERED)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  events         ApplicationEvent[]
  notifications  Notification[]

  @@unique([candidateId, canonicalJobId])
  @@index([candidateId])
  @@index([status])
  @@index([createdAt])
}

model ApplicationEvent {
  id            Int         @id @default(autoincrement())
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id])
  jobId         Int
  eventType     String
  payload       Json?
  createdAt     DateTime    @default(now())
}

model AutomationConfig {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique
  user             User      @relation(fields: [userId], references: [id])
  autoApplyEnabled Boolean   @default(false)
  workerStatus     String    @default("STOPPED")
  lastDiscoveryRun DateTime?
  nextDiscoveryRun DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model WorkerJob {
  id        Int      @id @default(autoincrement())
  queueName String
  jobId     String
  state     String
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([queueName, jobId])
}

model DeadLetter {
  id           Int      @id @default(autoincrement())
  jobId        String
  queueName    String
  error        String
  attemptCount Int
  stackTrace   String?
  timestamp    DateTime @default(now())
}

model ResumeVersion {
  id                   Int               @id @default(autoincrement())
  candidateId          Int
  candidate            CandidateProfile  @relation(fields: [candidateId], references: [id])
  jobId                Int
  job                  Job               @relation(fields: [jobId], references: [id])
  applicationId        Int
  application          Application       @relation(fields: [applicationId], references: [id])
  basedOnMasterResumeId Int
  basedOnMasterResume  Resume            @relation(fields: [basedOnMasterResumeId], references: [id])
  version              Int               @default(1)
  content              Json
  coverLetter          String?
  createdAt            DateTime          @default(now())

  @@unique([applicationId, version])
}

model Notification {
  id                   Int          @id @default(autoincrement())
  type                 String
  recipient            String
  payload              Json?
  relatedApplicationId Int?
  application          Application? @relation(fields: [relatedApplicationId], references: [id])
  sentAt               DateTime     @default(now())
  readAt               DateTime?
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  action     String
  targetType String
  targetId   Int
  metadata   Json?
  createdAt  DateTime @default(now())
}
