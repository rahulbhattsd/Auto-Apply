NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Local host-run development defaults. Docker Compose overrides these to use
# internal service names such as postgres and redis.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autoapply?schema=public"
REDIS_URL="redis://localhost:6379"

# Replace in every non-local environment.
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
APP_URL="http://localhost:5173"
API_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
COOKIE_SAME_SITE="lax"
# COOKIE_SECURE=true
SERVE_WEB=false

# Vite client config. The default /api works with the Vite dev proxy and nginx.
VITE_API_URL="/api"
VITE_API_PROXY_TARGET="http://localhost:3000"

UPLOAD_DIR="./uploads"

MAX_APPLICATIONS_PER_DAY=25
JOB_DISCOVERY_INTERVAL_MINUTES=30
MAX_CONCURRENT_APPLICATIONS=2

# Required only for AI-backed analysis/resume generation flows.
GROQ_API_KEY=""
GROQ_MODEL="llama3-8b-8192"

# Browser automation runs in the application worker.
PLAYWRIGHT_BROWSER="chromium"
PLAYWRIGHT_HEADLESS=true

# Optional email notifications. Leave blank locally unless you run SMTP/Mailhog.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.com"
