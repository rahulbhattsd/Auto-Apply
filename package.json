{
  "name": "autoapply",
  "version": "1.0.0",
  "private": true,
  "description": "AutoApply - Autonomous AI Job Application Platform",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build:render": "pnpm db:generate && pnpm run build",
    "start:workers": "node scripts/start-workers.cjs",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.1",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "add": "^2.0.9",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "eslint": "^9.0.0",
    "fastify-cookie": "^5.7.0",
    "fastify-multipart": "^5.4.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "pnpm": "9.0.0",
    "prettier": "^3.0.0",
    "prisma": "5.18.0",
    "tsx": "^4.0.0",
    "turbo": "^2.1.0",
    "typescript": "^5.5.0",
    "zod": "^3.23.8"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@prisma/client": "5.18.0"
  }
}
